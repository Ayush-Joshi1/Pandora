    {
      "parameters": {
        "jsCode": "const salesData = $input.all();\n// Use .first() to ensure we get the date regardless of branch depth\nconst todayDate = $('Get Today\\'s Date').first().json.todayDate;\n\nif (salesData.length === 0 || (salesData.length === 1 && !salesData[0].json[\"Product Name\"])) {\n  return {\n    json: {\n      date: todayDate,\n      totalRevenue: 0,\n      totalOrders: 0,\n      salesList: \"No sales today\"\n    }\n  };\n}\n\nlet totalRevenue = 0;\nconst productList = [];\n\nfor (const sale of salesData) {\n  const price = parseFloat(sale.json[\"Total Price\"]) || 0;\n  const product = sale.json[\"Product Name\"] || \"Unknown\";\n  const qty = sale.json[\"Quantity\"] || \"0\";\n  \n  totalRevenue += price;\n  productList.push(`${product} (Qty: ${qty}, Price: ${price})`);\n}\n\nreturn {\n  json: {\n    date: todayDate,\n    totalRevenue: totalRevenue.toFixed(2),\n    totalOrders: salesData.length,\n    salesList: productList.join(\"; \")\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        128
      ],
      "id": "967ff847-e6eb-4fea-8738-85c56135341f",
      "name": "Calculate Sales Metrics"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a sales analyst. Summarize today's sales and provide insights.\n\nSales Data for {{ $json.date }}:\n- Total Revenue: ${{ $json.totalRevenue }}\n- Total Orders: {{ $json.totalOrders }}\n- Sales List: {{ $json.salesList }}\n\nProvide a brief analysis in JSON format (no markdown):\n{\n  \"summary\": \"2-3 sentence summary of today's performance\",\n  \"status\": \"Excellent\" or \"Good\" or \"Poor\" or \"Critical\",\n  \"recommendation\": \"One actionable recommendation\"\n}\n\nStatus Guide:\n- Excellent: Revenue >= $600\n- Good: Revenue >= $300\n- Poor: Revenue > $0 but < $300\n- Critical: Revenue = $0",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        320,
        -64
      ],
      "id": "9a260985-3372-4185-ab98-870ef2ed0aa5",
      "name": "AI Sales Summary"
    },
    {
      "parameters": {
        "jsCode": "const metrics = $('Calculate Sales Metrics').first().json;\nconst aiOutput = $input.first().json;\n\n// Handle different AI response formats\nlet aiData = aiOutput;\nif (typeof aiOutput.text === 'string') {\n    try {\n        // Remove markdown formatting if present\n        const cleanJson = aiOutput.text.replace(/```json|```/g, '');\n        aiData = JSON.parse(cleanJson);\n    } catch (e) {\n        aiData = { summary: aiOutput.text, status: \"Unknown\", recommendation: \"Check logs\" };\n    }\n}\n\nreturn {\n  json: {\n    Date: metrics.date,\n    \"Total Revenue\": String(metrics.totalRevenue),\n    \"Total Orders\": String(metrics.totalOrders),\n    \"AI Summary\": aiData.summary || \"No summary available\",\n    \"Status\": aiData.status || \"Unknown\",\n    recommendation: aiData.recommendation || \"Continue monitoring\",\n    isUrgent: (aiData.status === \"Poor\" || aiData.status === \"Critical\")\n  }\n};"
      },
