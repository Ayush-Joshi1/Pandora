      "parameters": {
        "jsCode": "// This forces the date to be calculated based on a specific timezone\nconst today = new Date().toLocaleString(\"en-IN\", {timeZone: \"Asia/Kolkata\"});\n\n// The string comes back as \"DD/MM/YYYY, HH:MM:SS\", so we split it\nconst datePart = today.split(',')[0]; \nconst [day, month, year] = datePart.split('/');\n\nreturn {\n  json: {\n    todayDate: `${day.padStart(2, '0')}-${month.padStart(2, '0')}-${year}`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
