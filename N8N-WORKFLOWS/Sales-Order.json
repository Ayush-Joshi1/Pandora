      "parameters": {
        "jsCode": "const stockRows = $input.all().map(item => item.json);\nconst order = $(\"Basic LLM Chain\").first().json.output;\n\n// detect real header names dynamically\nconst productKey = Object.keys(stockRows[0]).find(k =>\n  k.trim() === \"ProductName\"\n);\n\nconst quantityKey = Object.keys(stockRows[0]).find(k =>\n  k.trim() === \"QuantityInStock\"\n);\n\nconst stockRow = stockRows.find(row =>\n  row[productKey]?.trim().toLowerCase() ===\n  order.product_name?.trim().toLowerCase()\n);\n\nif (!stockRow) {\n  return [{\n    json: {\n      order_product_name: order.product_name,\n      order_quantity: Number(order.quantity),\n      stock_product_name: null,\n      stock_quantity: 0,\n      productFound: false\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    order_product_name: order.product_name,\n    order_quantity: Number(order.quantity),\n    stock_product_name: stockRow[productKey],\n    stock_quantity: Number(stockRow[quantityKey]),\n    productFound: true\n  }\n}];\n"
      },
