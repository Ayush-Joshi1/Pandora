    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\nconst order = $(\"Basic LLM Chain\").first().json.output;\n\nreturn inputItems.map(item => {\n  const data = item.json;\n  \n  // Build the message using the structured data from the AI\n  const message = `Hello ${order.customer_name}, Thank you for your order! We have received your request for ${order.quantity} units of the ${order.product_name}. Your order is now being processed and will be shipped to ${order.shipping_address}. If you have any questions, please reply to this email. Thanks, Your E-commerce Team`;\n\n  return { json: { ...data, message } };\n});"
      },
