    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst firstItem = items[0].json;\nlet senderEmail = \"\";\n\n// --- 1. Handle Tally.so Webhook Data ---\n// Tally sends an array of fields in 'data.fields'\nif (firstItem.data && Array.isArray(firstItem.data.fields)) {\n  const emailField = firstItem.data.fields.find(f => \n    f.type === 'email' || \n    f.key?.toLowerCase().includes('email') || \n    f.label?.toLowerCase().includes('email')\n  );\n  senderEmail = emailField ? emailField.value : \"\";\n} \n\n// --- 2. Handle Gmail Trigger Data (Existing Logic) ---\nelse if (firstItem.from && Array.isArray(firstItem.from) && firstItem.from[0].address) {\n  senderEmail = firstItem.from[0].address;\n} \nelse if (firstItem.from && typeof firstItem.from === \"string\") {\n  const match = firstItem.from.match(/<(.+)>/);\n  senderEmail = match ? match[1] : firstItem.from;\n} \nelse if (firstItem.From && typeof firstItem.From === \"string\") {\n  const match = firstItem.From.match(/<(.+)>/);\n  senderEmail = match ? match[1] : firstItem.From;\n}\n\n// Return the original data plus the extracted senderEmail \n// so the rest of the workflow nodes can still see the raw input\nreturn [{ json: { ...firstItem, senderEmail } }];"
      },
